# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/bulk_email?schema=public"

# Application Settings
NODE_ENV="production"
PORT=4000
FRONTEND_URL="https://app.yourdomain.com"
JWT_SECRET="replace-with-cryptographically-secure-random-string-in-production"
JWT_EXPIRES_IN="7d"

# Queue Configuration ('sqs' for AWS Production, 'database' for standalone persistent queue)
QUEUE_DRIVER="sqs"
AWS_SQS_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/bulk-email-jobs"
AWS_SQS_DLQ_URL="https://sqs.us-east-1.amazonaws.com/123456789012/bulk-email-jobs-dlq"

# Email Provider ('ses' for AWS SES production, 'simulator' for local testing)
EMAIL_PROVIDER="ses"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
AWS_SES_SOURCE_EMAIL="campaigns@mail.yourdomain.com"
AWS_SES_CONFIGURATION_SET="bulk-email-events"

# Sending Rate & Concurrency Controls
DEFAULT_MAX_SENDING_RATE=5.0
DEFAULT_WORKER_CONCURRENCY=4
MAX_WORKER_CONCURRENCY=20

# Compliance & Safety Thresholds
DEFAULT_BOUNCE_THRESHOLD_PERCENT=5.0
DEFAULT_COMPLAINT_THRESHOLD_PERCENT=0.1
PHYSICAL_POSTAL_ADDRESS="123 Corporate Way, Victoria Island, Lagos, Nigeria"
COMPANY_NAME="Bulk Email Inc."
