{
  "family": "bulk-email-multi-provider",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::123456789012:role/bulk-email-ecsExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/bulk-email-ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "bulk-email-api",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/bulk-email-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000,
          "hostPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "QUEUE_DRIVER", "value": "sqs" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "AWS_SQS_QUEUE_URL", "value": "https://sqs.us-east-1.amazonaws.com/123456789012/bulk-email-production-jobs.fifo" },
        { "name": "AWS_SQS_DLQ_URL", "value": "https://sqs.us-east-1.amazonaws.com/123456789012/bulk-email-production-dlq.fifo" },
        { "name": "DEFAULT_ROUTING_STRATEGY", "value": "PRIORITY" },
        { "name": "START_EMBEDDED_WORKER", "value": "false" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:bulk-email/production/db" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:bulk-email/production/jwt" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bulk-email-production-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    },
    {
      "name": "bulk-email-worker",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/bulk-email-api:latest",
      "essential": true,
      "command": ["node", "dist/worker-runner.js"],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "QUEUE_DRIVER", "value": "sqs" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "AWS_SQS_QUEUE_URL", "value": "https://sqs.us-east-1.amazonaws.com/123456789012/bulk-email-production-jobs.fifo" },
        { "name": "AWS_SQS_DLQ_URL", "value": "https://sqs.us-east-1.amazonaws.com/123456789012/bulk-email-production-dlq.fifo" },
        { "name": "DEFAULT_WORKER_CONCURRENCY", "value": "10" },
        { "name": "WORKER_PROCESS_COUNT", "value": "4" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:bulk-email/production/db" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bulk-email-production-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}